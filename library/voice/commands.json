[
  {
    "id": "cancel",
    "description": "Discard the utterance (does nothing).",
    "patterns": [
      "cancel( that)?",
      "never ?mind( that)?",
      "forget (it|that|about it)",
      "ignore (that|this|me)",
      "scratch that",
      "nothing"
    ],
    "command": "none"
  },
  {
    "id": "undo",
    "description": "Undo the last scene change.",
    "patterns": [
      "undo( (that|it|this|the last (change|thing|step|one)))?",
      "undo undo",
      "go back( one step)?",
      "take (that|it) back"
    ],
    "command": "undo"
  },
  {
    "id": "redo",
    "description": "Redo the last undone change.",
    "patterns": [
      "re ?do( (that|it|this))?",
      "redo redo"
    ],
    "command": "redo"
  },
  {
    "id": "delete-target",
    "description": "Delete the entity being pointed at (or the selection).",
    "patterns": [
      "(delete|remove|trash|get rid of) (this|that|it)( (one|thing|widget|object|panel|entity))?",
      "(delete|remove) (the )?select(ed|ion)( (one|thing|widget|object|entity))?"
    ],
    "command": "delete",
    "args": { "entity": "$target" }
  },
  {
    "id": "duplicate-target",
    "description": "Duplicate the entity being pointed at (or the selection).",
    "patterns": [
      "(duplicate|copy|clone) (this|that|it)( (one|thing|widget|object|panel|entity))?",
      "(make|create) a copy( of (this|that|it))?",
      "(duplicate|copy|clone) (the )?select(ed|ion)( (one|thing|widget|object|entity))?"
    ],
    "command": "duplicate",
    "args": { "entity": "$target" }
  },
  {
    "id": "select-target",
    "description": "Select the entity being pointed at.",
    "patterns": [
      "select (this|that|it)( (one|thing|widget|object|panel|entity))?"
    ],
    "command": "broadcast",
    "args": { "name": "select", "args": { "entity": "$target" } }
  },
  {
    "id": "clear-selection",
    "description": "Clear the selection.",
    "patterns": [
      "(clear|reset|drop)( the)? selection",
      "(de ?select|un ?select)( (all|everything|this|that|it))?",
      "select nothing"
    ],
    "command": "broadcast",
    "args": { "name": "select", "args": { "entity": null } }
  },
  {
    "id": "show-agent-panel",
    "description": "Show the Claude/agent panel.",
    "patterns": [
      "(show|open|bring up)( me)?( the)? (claude|clod|clawed|cloud|clog|agent)( panel| window| chat)?",
      "(show|open)( the)? (panel|chat)"
    ],
    "command": "broadcast",
    "args": { "name": "agent.panel.toggle", "args": { "visible": true } }
  },
  {
    "id": "hide-agent-panel",
    "description": "Hide the Claude/agent panel.",
    "patterns": [
      "(hide|close|dismiss)( the)? (claude|clod|clawed|cloud|clog|agent)( panel| window| chat)?",
      "(hide|close|dismiss)( the)? (panel|chat)"
    ],
    "command": "broadcast",
    "args": { "name": "agent.panel.toggle", "args": { "visible": false } }
  },
  {
    "id": "mode-ar",
    "description": "Switch the headset to passthrough (AR / mixed reality).",
    "patterns": [
      "(switch|go|change|back|go back|switch back)( back)?( in)? ?to (ar|a r|passthrough|pass through|mixed reality|augmented reality|mr|m r)( mode)?",
      "(enter|start|use|enable|turn on)( the)? (ar|a r|passthrough|pass through|mixed reality|augmented reality)( mode)?",
      "(ar|a r|passthrough|pass through|mixed reality)( mode)?( on| please)?",
      "(passthrough|pass through) on"
    ],
    "command": "broadcast",
    "args": { "name": "session.mode", "args": { "mode": "ar" } }
  },
  {
    "id": "mode-vr",
    "description": "Switch the headset to full VR.",
    "patterns": [
      "(switch|go|change|back|go back|switch back)( back)?( in)? ?to (vr|v r|virtual reality|full vr|immersive)( mode)?",
      "(enter|start|use|enable|turn on)( the)? (vr|v r|virtual reality)( mode)?",
      "(vr|v r|virtual reality)( mode)?( on| please)?",
      "(passthrough|pass through) off",
      "(turn|switch) off( the)? (passthrough|pass through)"
    ],
    "command": "broadcast",
    "args": { "name": "session.mode", "args": { "mode": "vr" } }
  },
  {
    "id": "save-workspace",
    "description": "Save the current workspace (optionally under a new name: \"save workspace as weather demo\").",
    "patterns": [
      "save( (the|this|my))?( (workspace|work space|space|scene|layout|everything|it|this|all))?",
      "save( (the|this|my))? (workspace|work space|space|scene|layout) as (?<name>[a-z0-9][a-z0-9 _-]{0,40})"
    ],
    "command": "workspace.save",
    "args": { "name": "$name:slug" }
  },
  {
    "id": "recalibrate-origin",
    "description": "Re-center the space origin at the user's feet, facing their gaze.",
    "patterns": [
      "(re ?calibrate|re ?center|re ?centre)( the)?( (origin|space|room|world|view|position|floor))?",
      "(reset|recalibrate|recenter)( the)? (origin|space|room|world)( origin)?",
      "(center|centre) (the )?(space|room|world) (here|on me)"
    ],
    "command": "broadcast",
    "args": { "name": "origin.recalibrate" }
  },
  {
    "id": "github-show",
    "description": "Show a BeatSaberRL issue/PR in the GitHub details card (github-item widget), no Claude round trip.",
    "patterns": [
      "(show|open|load|display)( me)?( the)?( details( for| of)?)?( github)? (issue|pr|pull request|pull)( number)? #?(?<n>\\d+)( details)?( please)?",
      "(issue|pr|pull request)( number)? #?(?<n>\\d+)"
    ],
    "command": "channel.publish",
    "args": { "channel": "github.bsrl.ctl.show", "value": "$n" }
  },
  {
    "id": "video-play",
    "description": "Video: play / resume.",
    "patterns": [
      "(play|resume|unpause|continue)( the)?( video| playback)?"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "play"}}
  },
  {
    "id": "video-pause",
    "description": "Video: pause.",
    "patterns": [
      "pause( the)?( video| playback)?",
      "(stop|hold)( the)? (video|playback)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "pause"}}
  },
  {
    "id": "video-unmute",
    "description": "Video: unmute.",
    "patterns": [
      "unmute( the)?( video| sound| audio)?",
      "(sound|audio) on"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "unmute"}}
  },
  {
    "id": "video-mute",
    "description": "Video: mute.",
    "patterns": [
      "mute( the)?( video| sound| audio)?",
      "(sound|audio) off"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "mute"}}
  },
  {
    "id": "video-normal-speed",
    "description": "Video: normal speed.",
    "patterns": [
      "(normal|regular|reset( the)?) speed",
      "(set )?(the )?(playback |video )?speed( to)? (normal|regular|one)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "speed", "value": "normal"}}
  },
  {
    "id": "video-faster",
    "description": "Video: one speed step faster.",
    "patterns": [
      "(speed (it |the video )?up|faster|play faster)( please)?"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "faster"}}
  },
  {
    "id": "video-slower",
    "description": "Video: one speed step slower.",
    "patterns": [
      "(slow (it |the video )?down|slower|play slower)( please)?"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "slower"}}
  },
  {
    "id": "video-speed",
    "description": "Video: set playback speed (0.25–2), e.g. 'speed 1.5', 'play at 2x'.",
    "patterns": [
      "(set )?(the )?(playback |video )?speed( to)? (?<n>(?:\\d+(?: \\d+)?|zero|one|two|three|four|half|one and a half|one and a quarter|(?:zero|one|two) point (?:one|two|three|four|five|six|seven|eight|nine|\\d+)))(x| x| times)?",
      "(play )?(at )?(?<n>(?:\\d+(?: \\d+)?|zero|one|two|three|four|half|one and a half|one and a quarter|(?:zero|one|two) point (?:one|two|three|four|five|six|seven|eight|nine|\\d+)))(x| x| times)( speed)?"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "speed", "value": "$n"}}
  },
  {
    "id": "video-skip-seconds",
    "description": "Video: skip ahead N seconds/minutes (default 10 s).",
    "patterns": [
      "(skip|jump|go|fast forward|move)( ahead| forward)?( by)? (?<n>\\d+|[a-z]+(?: [a-z]+)?) (seconds?|secs?)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "skip", "value": "$n:number"}}
  },
  {
    "id": "video-skip-minutes",
    "description": "Video: skip ahead N seconds/minutes (default 10 s).",
    "patterns": [
      "(skip|jump|go|fast forward|move)( ahead| forward)?( by)? (?<m>\\d+|[a-z]+(?: [a-z]+)?) (minutes?|mins?)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "skip", "value": "$m:number", "unit": "min"}}
  },
  {
    "id": "video-skip",
    "description": "Video: skip ahead N seconds/minutes (default 10 s).",
    "patterns": [
      "(skip|jump)( ahead| forward)|fast forward"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "skip", "value": 10}}
  },
  {
    "id": "video-back-seconds",
    "description": "Video: go back N seconds/minutes (default 10 s).",
    "patterns": [
      "(go back|rewind|back|jump back|skip back)( by)? (?<n>\\d+|[a-z]+(?: [a-z]+)?) (seconds?|secs?)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "back", "value": "$n:number"}}
  },
  {
    "id": "video-back-minutes",
    "description": "Video: go back N seconds/minutes (default 10 s).",
    "patterns": [
      "(go back|rewind|back|jump back|skip back)( by)? (?<m>\\d+|[a-z]+(?: [a-z]+)?) (minutes?|mins?)"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "back", "value": "$m:number", "unit": "min"}}
  },
  {
    "id": "video-back",
    "description": "Video: go back N seconds/minutes (default 10 s).",
    "patterns": [
      "rewind|skip back|jump back"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "back", "value": 10}}
  },
  {
    "id": "video-restart",
    "description": "Video: restart from the beginning.",
    "patterns": [
      "(restart|start over|replay)( the)?( video)?",
      "(go )?(back )?to the (start|beginning)( of the video)?"
    ],
    "command": "channel.publish",
    "args": {"channel": "video.ctl", "value": {"cmd": "restart"}}
  }
]
